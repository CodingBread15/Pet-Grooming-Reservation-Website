@model User

@{
    ViewBag.Title = "Profile";
}

<div class="container">
    <div class="container-inner">
        <div class="form-title">Your profile</div>
        <table class="detail">
            <tr>
                <th>Id</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>
                    @(string.IsNullOrEmpty(Model.Phone) ? "No phone number :)" : Model.Phone)
                </td>
            </tr>
            <tr>
                <th>Photo</th>
                <td class="upload">
                    @if (String.IsNullOrEmpty(Model.Photo))
                    {
                        <img src="/images/photo.jpg" />
                    }
                    else
                    {
                        <img src="/images/@Model.Photo" />
                    }
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <section class="update-profile-button">
                        <div>
                            @if (User.IsInRole("Member"))
                            {
                                <button data-get="/User/UpdateProfile">Edit</button>
                            }
                        </div>
                        <div>
                            <button data-get="/User/Logout" class="red-button">Logout</button>
                        </div>
                    </section>
                </td>
            </tr>
        </table>
    </div>
</div>