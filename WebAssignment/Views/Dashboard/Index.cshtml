@model DashboardAdminVM

@{
    ViewBag.Title = "Operation's Dashboard";
}

<div class="noncentered-container">
    <h1 class="header-title">Dashboard</h1>
    <div class="dashboard-grid">
        <div class="dashboard-container-inner">
            <span class="dashboard-header">Total Number of Members</span>
            <span class="dashboard-data">@Model.MemberCount</span>
        </div>

        <div class="dashboard-container-inner">
            <span class="dashboard-header">Most Popular Grooming Package</span>
            <span class="dashboard-data">@Model.MostPopularServiceName</span>
        </div>

        <div class="dashboard-container-inner">
            <span class="dashboard-header">Total Number of Pets</span>
            <span class="dashboard-data">@Model.PetCount</span>
        </div>

        <div class="dashboard-container-inner">
            <span class="dashboard-header">Total Amount of Pending Bookings</span>
            <span class="dashboard-data">@Model.AppointmentPendingCount</span>
        </div>

        <div></div>

        <div class="dashboard-container-inner">
            <span class="dashboard-header">Bookings Happening Today</span>
            <span class="dashboard-data">@Model.AppointmentPendingTodayCount</span>
        </div>
    </div>
</div>